# --- Google Maps ---
# Browser key with "Maps JavaScript API" enabled. Restrict it to your domains
# (localhost:3000 + your Vercel domain) under HTTP referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional. A Map ID (Google Cloud → Maps Platform → Map Management) turns on the
# vector map: tilt, rotation and cloud-based styling. Leave empty for the raster map.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# --- Google sign-in (Auth.js) ---
# OAuth 2.0 Client ID of type "Web application".
# Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-vercel-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
